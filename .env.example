# Copy this file to .env.local and fill in the values.
# Get the actual keys from the project owner (shared securely — never in the repo/zip).

# --- Spotify Web API (powers the song search) ---
# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only if you use the OAuth (user login) flow:
SPOTIFY_REDIRECT_URI=

# --- Supabase (powers the live board / chart) ---
# From Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser) — for admin/service operations:
SUPABASE_SERVICE_ROLE_KEY=

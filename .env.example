# Copy this file to .env.local and fill in the values.
# Get the actual keys from the project owner (shared securely — never in the repo/zip).

# --- Club intake (Micah's platform) ---
# Shared secret for POST https://club-intake-ligo.nyc.appwrite.run/ (header x-ligo-intake-key).
# Used by /api/club-request. Without it the form falls back to email-only.
LIGO_INTAKE_KEY=

# --- Careers intake (Micah's platform) ---
# Shared secret for POST https://careers-intake-ligo.nyc.appwrite.run/ (header x-ligo-careers-key).
# Used by /api/apply. Without it an application is emailed but never reaches the review queue.
LIGO_CAREERS_KEY=

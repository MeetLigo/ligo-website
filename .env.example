# Copy this file to .env.local and fill in the values.
# Get the actual keys from the project owner (shared securely — never in the repo/zip).

# --- Club intake (Micah's platform) ---
# Shared secret for POST https://club-intake-ligo.nyc.appwrite.run/ (header x-ligo-intake-key).
# Used by /api/club-request. Without it the form falls back to email-only.
LIGO_INTAKE_KEY=

# --- Careers intake (Micah's platform) ---
# Shared secret for POST https://careers-intake-ligo.nyc.appwrite.run/ (header x-ligo-careers-key).
# Used by /api/apply. Without it an application is emailed but never reaches the review queue.
LIGO_CAREERS_KEY=

# --- Careers Slack notification ---
# Slack Incoming Webhook URL (https://hooks.slack.com/services/T.../B.../...)
# for the channel applications should land in. Create it at api.slack.com/apps
# → your app → Incoming Webhooks → Add New Webhook to Workspace, then pick the
# channel. Used by /api/apply. Without it applications still store and still
# email; nothing posts to Slack.
SLACK_CAREERS_WEBHOOK=

# --- Analytics ---
# GA4 measurement ID (G-XXXXXXXXXX) from the property under the Ligo Google
# Workspace. Read at build time by src/app/layout.tsx; without it no tag renders.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
